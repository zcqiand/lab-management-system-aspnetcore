# 进仓契约文件(L0.5 门管理):真 secret 由 VPS env-file 注入,此处是 key 契约 + 占位值
#
# key 集合与 .env.example 完全一致;值表语义:「key 契约 + 非 secret 已知 prod 值」。

# —— Server ——
SERVER_PORT=5000

# —— Database（lab_prod 数据库） ——
DATABASE_URL=Host=PROD-HOST;Port=5432;Database=lab_prod;Username=postgres;Password=placeholder-vps
DATABASE_NAME=lab_prod

# —— JWT (HS256, ADR-0008: 真后端 OAuth + JWT 签发) ——
JWT_SIGNING_KEY=placeholder-vps
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (SSO 模式直连 saas IdP, ADR-0009) ——
# prod 切 sso profile 走真实 saas。
LAB_SSO_PROFILE=sso

# —— CORS ——
# prod 只有三前端域名,无 localhost(dev origin 不进 production)。
# deploy 脚本幂等补 origin 逻辑不受影响。
LAB_CORS_ALLOWED_ORIGINS=https://lab-vue.xiangru.uk,https://lab-react.xiangru.uk,https://lab-nextjs.xiangru.uk
