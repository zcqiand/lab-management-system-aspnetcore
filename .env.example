# lab-management-system-aspnetcore — 开发期环境变量模板
#
# Phase 4 env 对称化: ASP.NET env provider 直接读 flat key, 不走 `:` 段映射。
# 镜像 saas-identity-platform-* + lab-management-system-{msw,springboot} 五仓共享命名。

# —— Server ——
# SERVER_PORT 是全家族统一监听 key（Program.cs ServerPortShim 接线; aspnetcore=5000 conventions §6）。
SERVER_PORT=5000

# —— Database（lab_dev 数据库，全家族统一 key；值为 Npgsql 格式） ——
# 默认 Host=100.79.128.25;Port=5432;Database=lab_dev（EF 路径 Program.cs 读 DATABASE_URL）
DATABASE_URL=Host=100.79.128.25;Port=5432;Database=lab_dev;Username=postgres;Password=changeme
DATABASE_NAME=lab_dev

# —— JWT (HS256, ADR-0008: 真后端 OAuth + JWT 签发) ——
# 镜像 saas-identity-platform-* + lab-management-system-{msw,springboot} 六仓共享同一 JWT_SIGNING_KEY
# (≥32B 硬约束)。SSO 模式验签 saas 签发的 token, no-sso 模式 LabTokenValidationFactory 真签。
# prod 路径：deploy 脚本首启自举随机密钥持久化进 env-file。
# Phase 4 env 对称化: Lab:Jwt:* → JWT_* flat key。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (SSO 模式直连 saas IdP, ADR-0009) ——
# SSO 配置走 Lab:Sso section（env 形式 Lab__Sso__*，与 deploy 脚本一致；
# appsettings.Development.json 已含 dev 默认值，通常无需 env 覆盖）：
#   Lab__Sso__Profile=no-sso          （Program.cs 直读 LAB_SSO_PROFILE 亦生效）
#   Lab__Sso__SaasBase=http://localhost:3000
#   Lab__Sso__LoginUrl=               （缺省回落 SaasBase）
#   Lab__Sso__ClientId=lab-mgmt
#   Lab__Sso__ClientSecret=lab-mgmt-secret
#   Lab__Sso__DefaultTenantId=00000000-0000-0000-0000-000000000001
#   Lab__Sso__CallbackRedirectBase=http://localhost:5173/login
LAB_SSO_PROFILE=no-sso

# —— CORS ——
# Phase 4 env 对称化: Lab:Cors:AllowedOrigins → LAB_CORS_ALLOWED_ORIGINS flat key。
# dev localhost 三前端 + lab family prod 三前端域名（lab-aspnetcore 同源 origin 是自签 + 跨栈 SSO 入口）。
# prod 路径 deploy 脚本会幂等补 LAB_CORS_ALLOWED_ORIGINS（不覆盖运维手工加的 origin）。
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000