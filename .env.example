# lab-management-system-aspnetcore — 开发期环境变量模板
#
# appsettings.json 是 SSOT；本文件列出可用 env override（ASP.NET 标准
# 双下划线 Section__Key 或冒号 Section:Key 自动覆盖）。

# —— Server ——
ASPNETCORE_URLS=http://localhost:5000

# —— Database（lab_dev 数据库） ——
# 默认 Host=100.79.128.25;Port=5432;Database=lab_dev
ConnectionStrings__Postgres=Host=100.79.128.25;Port=5432;Database=lab_dev;Username=postgres;Password=changeme
LAB_DB=lab_dev

# —— JWT (HS256, ADR-0008: 真后端 OAuth + JWT 签发) ——
# 镜像 saas-identity-platform-* + lab-management-system-{msw,springboot} 五仓共享同一 Lab:Jwt:Secret
# (≥32B 硬约束)。SSO 模式验签 saas 签发的 token, no-sso 模式 LabTokenValidationFactory 真签。
# prod 路径：deploy 脚本首启自举随机密钥持久化进 env-file。
Lab:Jwt:Secret=dev-key-32-bytes-minimum-length!
Lab:Jwt:Issuer=lab-management-system
Lab:Jwt:Audience=lab-management-system-clients
Lab:Jwt:TtlSeconds=3600

# —— saas OAuth (SSO 模式直连 saas IdP, ADR-0009) ——
# 默认 no-sso profile, prod 切 sso profile 走真实 saas
Lab:Saas:BaseUrl=http://localhost:3001
Saas:Cors:AllowedOrigins=http://localhost:5173,http://localhost:3000,http://localhost:3001