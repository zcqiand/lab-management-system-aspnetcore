# lab-management-system-aspnetcore — 开发期环境变量模板
#
# Phase 4 env 对称化: ASP.NET env provider 直接读 flat key, 不走 `:` 段映射。
# 镜像 saas-identity-platform-* + lab-management-system-{msw,springboot} 五仓共享命名。

# —— Server ——
ASPNETCORE_URLS=http://localhost:5000

# —— Database（lab_dev 数据库） ——
# 默认 Host=100.79.128.25;Port=5432;Database=lab_dev
ConnectionStrings__Postgres=Host=100.79.128.25;Port=5432;Database=lab_dev;Username=postgres;Password=changeme
LAB_DB=lab_dev

# —— JWT (HS256, ADR-0008: 真后端 OAuth + JWT 签发) ——
# 镜像 saas-identity-platform-* + lab-management-system-{msw,springboot} 六仓共享同一 JWT_SIGNING_KEY
# (≥32B 硬约束)。SSO 模式验签 saas 签发的 token, no-sso 模式 LabTokenValidationFactory 真签。
# prod 路径：deploy 脚本首启自举随机密钥持久化进 env-file。
# Phase 4 env 对称化: Lab:Jwt:* → JWT_* flat key。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (SSO 模式直连 saas IdP, ADR-0009) ——
# Phase 4 env 对称化: Lab:Sso:* → LAB_SAAS_* / LAB_SSO_* flat key
LAB_SSO_PROFILE=no-sso
LAB_SAAS_BASE_URL=http://localhost:3001
LAB_SAAS_CLIENT_ID=lab-mgmt
LAB_SAAS_CLIENT_SECRET=lab-mgmt-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_LOGIN_URL=
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5173/login

# —— CORS ——
# Phase 4 env 对称化: Lab:Cors:AllowedOrigins → LAB_CORS_ALLOWED_ORIGINS flat key。
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000