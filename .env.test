# .env.test — lab-management-system-aspnetcore L4 测试期覆盖
#
# JWT_SIGNING_KEY 与 lab-management-system-msw 共享 (≥32B 硬约束)。
# Phase 4 env 对称化: Lab:Jwt:Secret → JWT_SIGNING_KEY flat key。

JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# === 以下 key 与 .env.example 全集对齐（T10: key 集合拉齐,值用 example dev 值）===
SERVER_PORT=5000
DATABASE_URL=Host=100.79.128.25;Port=5432;Database=lab_dev;Username=postgres;Password=changeme
DATABASE_NAME=lab_dev
LAB_SSO_PROFILE=no-sso
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000