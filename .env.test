# .env.test — lab-management-system-aspnetcore L4 测试期覆盖
#
# JWT_SIGNING_KEY 与 lab-management-system-msw 共享 (≥32B 硬约束)。
# Phase 4 env 对称化: Lab:Jwt:Secret → JWT_SIGNING_KEY flat key。

JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600