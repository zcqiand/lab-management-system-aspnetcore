{
  "schema": 1,
  "suite_version": "0.6.0",
  "project": "lab-management-system-aspnetcore",
  "stack": "aspnetcore",
  "gates": {
    "L1": {
      "name": "格式",
      "cmd": [
        "dotnet",
        "format",
        "src/Lab.AspNetCore.csproj",
        "--verify-no-changes"
      ],
      "fix": "运行 `dotnet format src/Lab.AspNetCore.csproj` 后重试。"
    },
    "L2": {
      "name": "静态检查",
      "cmd": [
        "dotnet",
        "build",
        "src/Lab.AspNetCore.csproj",
        "/p:TreatWarningsAsErrors=true"
      ],
      "fix": "逐条修复 warning。"
    },
    "L3": {
      "name": "编译",
      "cmd": [
        "dotnet",
        "build",
        "tests/Lab.AspNetCore.Tests.csproj"
      ],
      "fix": "先让它编译过。（build tests 会经 ProjectReference 连带 build src）"
    },
    "L4": {
      "name": "测试",
      "cmd": [
        "dotnet",
        "test",
        "tests/Lab.AspNetCore.Tests.csproj",
        "--no-build"
      ],
      "fix": "先让测试变绿。（依赖 L3 已 build）"
    }
  },
  "trace_cmd": [
    "python",
    "scripts/gen-trace.py"
  ],
  "trace_env": {},
  "source_dirs": [
    "src"
  ],
  "test_dirs": [
    "tests"
  ]
}
